    VerifierKey::from_tau_g2(
        g2_from_be_bytes(
            [
                2, 74, 162, 178, 240, 143, 10, 145, 38, 8, 5, 39, 45, 197, 16, 81, 198, 228, 122,
                212, 250, 64, 59, 2, 180, 81, 11, 100, 122, 227, 209, 119, 11, 172, 3, 38, 168, 5,
                187, 239, 212, 128, 86, 200, 193, 33, 189, 184,
