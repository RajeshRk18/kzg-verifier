                19, 224, 43, 96, 82, 113, 159, 96, 125, 172, 211, 160, 136, 39, 79, 101, 89, 107,
                208, 208, 153, 32, 182, 26, 181, 218, 97, 187, 220, 127, 80, 73, 51, 76, 241, 18,
                19, 148, 93, 87, 229, 172, 125, 5, 93, 4, 43, 126,
            ],
            [
                12, 229, 213, 39, 114, 125, 110, 17, 140, 201, 205, 198, 218, 46, 53, 26, 173, 253,
                155, 170, 140, 189, 211, 167, 109, 66, 154, 105, 81, 96, 209, 44, 146, 58, 201, 204,
                59, 172, 162, 137, 225, 147, 84, 134, 8, 184, 40, 1,
            ],
            [
                6, 6, 196, 160, 46, 167, 52, 204, 50, 172, 210, 176, 43, 194, 139, 153, 203, 62, 40,
                126, 133, 167, 99, 175, 38, 116, 146, 171, 87, 46, 153, 171, 63, 55, 13, 39, 92,
                236, 29, 161, 170, 169, 7, 95, 240, 95, 121, 190,
            ],
        ),
        g2_from_be_bytes(
            [
                5, 223, 58, 117, 141, 23, 136, 194, 85, 244, 157, 22, 212, 64, 110, 10, 200, 220,
                250, 15, 80, 45, 79, 41, 94, 152, 113, 78, 18, 100, 134, 65, 231, 187, 120, 181, 44,
                58, 208, 54, 46, 164, 37, 99, 9, 251, 16, 59,
            ],
            [
                22, 86, 219, 165, 161, 15, 137, 231, 243, 159, 156, 198, 150, 108, 82, 81, 182, 95,
                231, 227, 116, 81, 131, 27, 246, 132, 46, 245, 244, 125, 129, 20, 203, 81, 163, 198,
                208, 212, 156, 16, 4, 204, 235, 251, 46, 148, 236, 46,
            ],
            [
                24, 199, 203, 167, 89, 208, 110, 201, 159, 241, 42, 68, 48, 226, 70, 123, 228, 90,
                89, 110, 199, 42, 56, 224, 182, 24, 22, 102, 142, 133, 209, 90, 231, 73, 49, 86, 20,
                235, 232, 181, 218, 43, 133, 62, 97, 153, 21, 54,
